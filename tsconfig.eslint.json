{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "experimentalDecorators": true
  },
  "include": ["packages/*/src/**/*", "packages/*/tests/**/*", "packages/*/vite.config.ts"]
}
