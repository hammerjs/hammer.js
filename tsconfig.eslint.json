{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDir": ".",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "experimentalDecorators": true
  },
  "include": ["packages/*/src/**/*", "packages/*/tests/**/*", "packages/*/vite*.config.ts"]
}
