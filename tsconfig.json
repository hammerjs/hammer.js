{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["DOM", "ES2022"],
    "declaration": true,
    "declarationDir": "dist/types",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
